#!/usr/bin/env bash
# Install tree-sitter grammars for every language hutch supports.
# Requires git and a C compiler (cc).  Grammars are installed under
# ~/.emacs.d/tree-sitter/ via `treesit-install-language-grammar'.
#
# Usage:
#   bin/install-grammars          # install all
#   EMACS=/path/to/emacs bin/install-grammars
#
# Per-grammar failures are logged and do not abort the run, so one
# unreachable source doesn't block the others.

set -euo pipefail

EMACS="${EMACS:-emacs}"

"$EMACS" --batch --eval '
(progn
  (require (quote treesit))
  (setq treesit-language-source-alist
        (quote ((python     "https://github.com/tree-sitter/tree-sitter-python")
                (ruby       "https://github.com/tree-sitter/tree-sitter-ruby")
                (rust       "https://github.com/tree-sitter/tree-sitter-rust")
                (javascript "https://github.com/tree-sitter/tree-sitter-javascript")
                (typescript "https://github.com/tree-sitter/tree-sitter-typescript" nil "typescript/src")
                (tsx        "https://github.com/tree-sitter/tree-sitter-typescript" nil "tsx/src")
                (go         "https://github.com/tree-sitter/tree-sitter-go")
                (java       "https://github.com/tree-sitter/tree-sitter-java")
                (c          "https://github.com/tree-sitter/tree-sitter-c")
                (cpp        "https://github.com/tree-sitter/tree-sitter-cpp")
                (clojure    "https://github.com/sogaiu/tree-sitter-clojure")
                (elixir     "https://github.com/elixir-lang/tree-sitter-elixir"))))
  (let ((ok 0) (fail 0))
    (dolist (lang (mapcar (function car) treesit-language-source-alist))
      (message ">> %s" lang)
      (condition-case err
          (progn (treesit-install-language-grammar lang)
                 (setq ok (1+ ok)))
        (error
         (setq fail (1+ fail))
         (message "   FAILED: %s" (error-message-string err)))))
    (message "")
    (message "Installed %d grammar(s); %d failed." ok fail)
    (when (> fail 0) (kill-emacs 1))))'
